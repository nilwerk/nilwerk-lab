# Bench CI image only: the setup image built by ci.yml job firmware (build-setup). Listed LAST in SDKCONFIG_DEFAULTS, so it wins.
# Effect: the board stays awake on USB. The bench measurement loop never deep-sleeps.
# Why UNSET and not "=n": the loop sleeps only when the option is defined (main/main.c:37-41):
#   defined     -> CYCLES_BEFORE_SLEEP 5, then the deep sleep at main/main.c:155-159 (60 s timer)
#   not defined -> CYCLES_BEFORE_SLEEP 0x7fffffff, the loop never ends and the sleep call is never reached
# Kconfig default is y (main/Kconfig.projbuild:39-41), and sdkconfig.defaults.v1:9 sets y, so this file must UNSET it.
# Not changed here: the setup-flow deep sleep with no timer for a closed, never-provisioned unit (main/main.c:81-87).
# The default build, the v1 build and the upload build do not list this file.
# CONFIG_PLANT_BENCH_SLEEP_CYCLE is not set
# BLE setup window on every cold start, without BOOT (bench image only; owner sign-off needed). See main/Kconfig.projbuild.
CONFIG_PLANT_BENCH_AUTO_SETUP=y
# Bench CI image only: BLE setup window of 300 s (main/Kconfig.projbuild, PLANT_BENCH_SETUP_WINDOW_S), the same length as the
# product text "Setup mode closes after 5 minutes" (A-137; the CI guards in .github/workflows pin 300 s under A-138). Why not 60 s:
# the bench has no person to press the pinhole button, so the automated steps after sign-in (add the sensor in the app, step d
# of bench.yml) need the window open. Step b reads the wake lines only after it closes (A-139). Product firmware is unchanged (300 s).
CONFIG_PLANT_BENCH_SETUP_WINDOW_S=300
# Bench CI image only (A-094): soil probe supply stays on between readings, so the probe value can be tested. NFR-12 is not met here.
# Kconfig PLANT_BENCH_SOIL_POWER_ON (main/Kconfig.projbuild). Production, v1 and upload builds do not list this file.
CONFIG_PLANT_BENCH_SOIL_POWER_ON=y
# Hourly upload on the bench, once a minute (owner decision 2026-11-23). Test account only; the data is deleted after the test.
# The cloud base URL is NOT set here. The bench workflow (bench.yml, job build-firmware, once PR #186 is merged) writes
# CONFIG_PLANT_API_BASE_URL into firmware/sdkconfig.defaults.local (git-ignored, never committed) and lists that file LAST:
# sdkconfig.defaults;sdkconfig.defaults.v1;sdkconfig.defaults.setup;sdkconfig.defaults.bench-ci;sdkconfig.defaults.local.
# So this file is not last in that bench build. It does not set CONFIG_PLANT_API_BASE_URL, so the order does not change the URL.
# The ci.yml setup build does not list sdkconfig.defaults.local.
CONFIG_PLANT_UPLOAD=y
CONFIG_PLANT_BENCH_UPLOAD_MINUTE=y
